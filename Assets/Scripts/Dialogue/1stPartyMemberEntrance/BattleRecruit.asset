  m_Script: {fileID: 11500000, guid: 7a9ff481f6c708747b6a9617fff92311, type: 3}
  m_Name: BattleRecruit
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Hirose
    portrait: {fileID: 2378355503943272512, guid: d5c8eb7167e897d45b7fce5da898e35a, type: 3}
    text: And who might you be?
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
  - speakerName: Edward
    portrait: {fileID: -996614095021860825, guid: fef7ca89a6483c149870e7045b110c5b, type: 3}
    text: I'm Edward Figglebottom, here to help out.
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
  - speakerName: Hirose
    portrait: {fileID: 2378355503943272512, guid: d5c8eb7167e897d45b7fce5da898e35a, type: 3}
    text: Why would you help me?
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
  - speakerName: Edward
    portrait: {fileID: -996614095021860825, guid: fef7ca89a6483c149870e7045b110c5b, type: 3}
    text: We're both humans aren't we? We need to look out for eachother. Not to
      mention I need more people for my journey.
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
  - speakerName: Hirose
    portrait: {fileID: 2378355503943272512, guid: d5c8eb7167e897d45b7fce5da898e35a, type: 3}
    text: Quite ambitious aren't we?
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
  - speakerName: Edward
    portrait: {fileID: -996614095021860825, guid: fef7ca89a6483c149870e7045b110c5b, type: 3}
    text: Just focus on the fight...
    typingSpeed: 0.1
    autoAdvance: 0
    autoAdvanceDelay: 0
